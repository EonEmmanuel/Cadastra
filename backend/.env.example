# Cadastra-Cameroon — backend runtime secrets
# Copy this file to `.env` (git-ignored) and fill in real values.
# main.py loads it automatically at startup via python-dotenv.

# --- Meta Model API key (gateway for Muse Spark + SAM 3.1) ---
# The Meta docs(https://dev.meta.ai/docs/) name this env var MODEL_API_KEY;
# the platform models are Muse Spark 1.1/1.2/1.3 and SAM 3.1.
# NOTE: Llama is not on this API, and open-weight models (Muse Glimmer,
# Muse Spark Open) are self-hosted only — not callable with this key.
META_API_KEY=

# Optional overrides (verified defaults in main.py):
# META_EXTRACT_MODEL_ID=muse-spark-1.3
#   Same model at ~12-21x cheaper tokens: muse-spark-1.3-contributor —
#   in exchange, Meta may use submitted content to train future Meta models.
#   (150 RPM limit; fine for demos, consider Standard mode for real citizen data.)
# META_VISION_MODEL_ID=sam-3.1

# --- WhatsApp Cloud API (Meta) — outbound replies to citizens ---
# Business bot credentials from https://developers.facebook.com > WhatsApp > API Setup.
# The token must belong to a System User with whatsapp_business_messaging permission.
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

# Shared secret used to verify webhook subscriptions (GET hub.verify_token).
# Choose any hard-to-guess string; it must match what you enter in the
# App Dashboard > WhatsApp > Configuration > Webhook verify token field.
WHATSAPP_VERIFY_TOKEN=cadastra_cameroon_local_token
